# vercel
FRONTEND/.vercel

# typescript
FRONTEND/*.tsbuildinfo
FRONTEND/next-env.d.ts

# =========================
# Python / FastAPI (BACKEND)
# =========================
# Byte-compiled / optimized / DLL files
BACKEND/__pycache__/

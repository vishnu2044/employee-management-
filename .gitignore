# =========================
# Node.js / Next.js (FRONTEND)
# =========================
# dependencies
FRONTEND/node_modules/
FRONTEND/.pnp
FRONTEND/.pnp.js

# testing
FRONTEND/coverage/

# next.js
FRONTEND/.next/
FRONTEND/out/

# production
FRONTEND/build/

# misc

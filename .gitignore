BACKEND/.installed.cfg
BACKEND/*.egg
BACKEND/MANIFEST

# Virtual environments
BACKEND/.env
BACKEND/.venv
BACKEND/env/
BACKEND/venv/
BACKEND/ENV/
BACKEND/env.bak/
BACKEND/venv.bak/

# Environment variables
BACKEND/.env
BACKEND/.env.*
!BACKEND/.env.example

# SQLite Database
BACKEND/*.sqlite3
BACKEND/app.db
BACKEND/employee_attendance.db

# Misc

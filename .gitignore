BACKEND/*$py.class

# C extensions
BACKEND/*.so

# Distribution / packaging
BACKEND/.Python
BACKEND/build/
BACKEND/develop-eggs/
BACKEND/dist/
BACKEND/downloads/
BACKEND/eggs/
BACKEND/.eggs/
BACKEND/lib/
BACKEND/lib64/
BACKEND/parts/
BACKEND/sdist/
BACKEND/var/
BACKEND/wheels/
BACKEND/share/python-wheels/
